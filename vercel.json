{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" },
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/manage", "destination": "/index.html" },
    { "source": "/manage/:path*", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
