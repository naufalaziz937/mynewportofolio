NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_os
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional frontend origins for LAN/mobile testing.
CLIENT_URLS=
# Generate with a cryptographically random generator; at least 32 characters.
AUTH_SECRET=
# Set to 1 only when the API is behind one trusted reverse proxy.
TRUST_PROXY=0
# Use 'none' only for cross-site HTTPS deployments.
COOKIE_SAME_SITE=lax
ADMIN_USERNAME=admin
# Used only by the explicit npm run create-admin command. Remove afterward.
ADMIN_INITIAL_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
